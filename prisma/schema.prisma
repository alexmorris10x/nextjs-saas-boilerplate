generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// NextAuth.js Models
// ============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// User Model
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Stripe customer ID
  customerId String? @unique

  // Subscription status
  subscriptionStatus SubscriptionStatus @default(new)
  subscriptionId     String?
  priceId            String?
  trialEndDate       DateTime?
  trialStartDate     DateTime?
  hasLifetimeAccess  Boolean            @default(false)

  // Onboarding & additional tracking
  uuid                String?   @unique @default(cuid())
  onboardingCompleted Boolean   @default(false)
  subscribedAt        DateTime?
  subscriptionEndDate DateTime?
  paymentFingerprint  String?   @unique

  // Feedback access and immutable first-touch attribution
  compUntil         DateTime?
  accessSource      String?
  feedbackPassCode  String?
  signupRef         String?
  signupUtmSource   String?
  signupUtmMedium   String?
  signupUtmCampaign String?

  // Relations
  feedbackPassRedemptions FeedbackPassRedemption[]
  accounts                Account[]
  sessions                Session[]
  subscriptions           Subscription[]
  settings                UserSettings?

  @@index([customerId])
  @@index([subscriptionStatus])
}

enum SubscriptionStatus {
  new
  active
  past_due
  canceled
  expired
  incomplete
  incomplete_expired
  trialing
  unpaid
}

// ============================================================================
// Subscription Models (Stripe)
// ============================================================================

/// Stores the active or historical Stripe subscription for a user
model Subscription {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  stripeSubId      String             @unique
  stripeCustomerId String
  priceId          String?
  status           SubscriptionStatus
  trialStart       DateTime?
  trialEnd         DateTime?
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SubscriptionEvent[]
}

/// Persists each Stripe webhook we process for idempotency & audit
model SubscriptionEvent {
  id                   String        @id @default(cuid())
  subscription         Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId       String?
  stripeSubscriptionId String?

  stripeEventId String   @unique
  type          String
  payload       Json
  processedAt   DateTime @default(now())
}

// ============================================================================
// User Settings
// ============================================================================

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  theme     Theme    @default(light)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Theme {
  light
  dark
}

// No billing objects are created by feedback passes.
model FeedbackPass {
  id          String                   @id @default(cuid())
  code        String                   @unique
  months      Int                      @default(3)
  maxUses     Int                      @default(100)
  uses        Int                      @default(0)
  expiresAt   DateTime?
  note        String?
  createdAt   DateTime                 @default(now())
  redemptions FeedbackPassRedemption[]
}

// A durable ledger keeps repeated redemptions idempotent across different codes.
model FeedbackPassRedemption {
  id             String       @id @default(cuid())
  userId         String
  feedbackPassId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbackPass   FeedbackPass @relation(fields: [feedbackPassId], references: [id], onDelete: Cascade)

  @@unique([userId, feedbackPassId])
}

model WaitlistSignup {
  id                     String    @id @default(cuid())
  email                  String    @unique
  source                 String?
  product                String?
  createdAt              DateTime  @default(now())
  confirmationSentAt     DateTime?
  confirmationClaimToken String?
  confirmationClaimedAt  DateTime?

  @@index([createdAt])
}
